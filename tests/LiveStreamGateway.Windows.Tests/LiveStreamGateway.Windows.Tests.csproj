<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefineConstants>$(DefineConstants);WINDOWS_TRAY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\WindowsStartupRegistration.cs" Link="WindowsStartupRegistration.cs" />
    <Compile Include="..\..\WindowsAppIcon.cs" Link="WindowsAppIcon.cs" />
    <EmbeddedResource Include="..\..\assets\LiveStreamGateway.ico" LogicalName="LiveStreamGateway.AppIcon.ico" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
